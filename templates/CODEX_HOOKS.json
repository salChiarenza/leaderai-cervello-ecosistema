{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.agent/hooks/guardiano_stanze.sh\"",
            "commandWindows": "powershell.exe -NoProfile -ExecutionPolicy Bypass -Command \"$leaderaiRoot = (git rev-parse --show-toplevel); & (Join-Path $leaderaiRoot '.agent/hooks/guardiano_stanze_windows.ps1')\"",
            "timeout": 30,
            "statusMessage": "Controllo ordine Ecosistema"
          }
        ]
      }
    ]
  }
}
