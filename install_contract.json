{
  "schema_version": 1,
  "supported_agents": [
    "codex",
    "claude",
    "both"
  ],
  "official_sources": [
    {
      "id": "anthropic_claude_code_overview",
      "url": "https://code.claude.com/docs/en/overview",
      "role": "technical_entrypoint",
      "comparison": "Superficie Claude Code, ingresso nel workspace, capacita e navigazione della documentazione tecnica viva."
    },
    {
      "id": "openai_chatgpt_docs",
      "url": "https://learn.chatgpt.com/docs",
      "role": "technical_entrypoint",
      "comparison": "Documentazione viva OpenAI da cui raggiungere le regole tecniche pertinenti a Codex, istruzioni di progetto, skill e configurazione."
    },
    {
      "id": "openai_codex_for_work",
      "url": "https://openai.com/it-IT/academy/codex-for-work/",
      "role": "operational_training",
      "comparison": "Pratiche operative di Codex nel lavoro; orienta le prove d'uso e non sostituisce le specifiche tecniche."
    },
    {
      "id": "anthropic_claude_code_hooks",
      "url": "https://code.claude.com/docs/en/hooks",
      "role": "technical_specification",
      "comparison": "Specifica viva dei project hook Claude Code, del blocco Stop, di stop_hook_active e dell'esecuzione Git Bash su Windows."
    },
    {
      "id": "openai_codex_hooks",
      "url": "https://learn.chatgpt.com/docs/hooks",
      "role": "technical_specification",
      "comparison": "Specifica viva dei project hook Codex, del trust, di commandWindows e del comportamento Stop."
    },
    {
      "id": "anthropic_claude_code_memory",
      "url": "https://code.claude.com/docs/en/memory",
      "role": "technical_specification",
      "comparison": "Specifica viva dei file CLAUDE.md per scope (managed, utente ~/.claude/CLAUDE.md, progetto, locale), dell'import @AGENTS.md e di autoMemoryDirectory."
    },
    {
      "id": "openai_codex_agents_md",
      "url": "https://learn.chatgpt.com/docs/agent-configuration/agents-md",
      "role": "technical_specification",
      "comparison": "Specifica viva del caricamento gerarchico di AGENTS.md: globale ~/.codex/AGENTS.md, radice progetto, sottocartelle, override e tetto project_doc_max_bytes."
    }
  ],
  "inspection_policies": {
