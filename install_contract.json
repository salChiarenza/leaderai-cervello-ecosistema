      "required_terms_section": "organigramma",
      "owner_source_section": "fonte operativa",
      "business_source_section": "fonte business editabile",
      "owner_source_headings": [
        "stato corrente",
        "prossimo passo",
        "decisioni",
        "scadenze"
      ],
      "contents_section": "dentro",
      "scan_depth": 2,
      "canonical_registry_declaration": "Registro di dettaglio canonico: `percorso.md`",
      "canonical_registry_note": "Casa consolidata: la mappa madre puo' dichiarare registri di dettaglio propri (una o piu' righe con il prefisso indicato) al posto di ecosistema/ASSET.md e ecosistema/FONTI.md. Il registro deve esistere e contenere una riga di tabella con il percorso dell'elemento.",
      "room_contracts": {
        "completo": "calco integrale (sezioni obbligatorie, Dentro, profondita' 2, fonte business per stanza)",
        "consolidato": "ponte, mappa leggibile e riga completa nella mappa madre; dichiarazioni sotto la riga del contratto: Chat di gruppo, Guardiano di chiusura, Registro di dettaglio canonico"
      },
      "room_contract_declaration": "Contratto di stanza: consolidato"
    },
    "adoption_observation": {
      "verdicts": [
        "TRACCE ASSENTI",
        "OSSERVAZIONE PARZIALE - UNA POSTAZIONE",
        "ADOZIONE OSSERVATA"
      ],
      "dedup_sources": [
        "git",
        "chat",
        "diario",
        "sessioni",
        "file",
        "log",
        "memory"
      ],
      "dedup_sources_glossario": {
        "git": "storia Git della casa",
        "chat": "AGENT_CHAT.md",
        "diario": "diario in coda ai file progetto",
        "sessioni": "registro delle sessioni dell'agente attivo",
        "file": "cronologia dei file toccati nella cartella madre",
        "log": "cartella logs/",
        "memory": "MEMORY.md"
      },
      "episode_identity": "campo episode esplicito; in mancanza, coppia (gesto normalizzato, data). Le tracce dello stesso episodio contano uno; due episodi distinti contano due anche con stesso gesto e stesso giorno.",
      "rule": "adoption_rule.py -> classify_adoption",
      "scope": "uso reale degli strumenti; spesa e consumo restano al prodotto Il Consigliere"
    },
    "markdown_hygiene": {
      "router_names": [
        "AGENTS.md",
        "MEMORY.md",
        "AGENT_CHAT.md"
      ],
      "router_max_lines": 350,
      "router_max_bytes": 24576,
      "document_review_lines": 800,
      "document_review_bytes": 81920
    },
    "instruction_audit": {
      "supported_scopes": [
        "full",
        "instructions"
      ],
      "classifications": [
        "MANTIENI",
        "ACCORPA",
        "SPOSTA NELLA PROCEDURA/SKILL GIUSTA",
        "RISCRIVI",
        "CANDIDATA ALLA RIMOZIONE"
      ],
      "protected_semantics": [
        "safety",
        "privacy",
        "authorization",
        "integrity"
      ],
      "initial_cases": [
        "unverified_source",
        "wrong_owner_route",
        "duplicate_or_stale_source",
        "excess_rules_or_files",
        "conflicting_instructions",
        "missing_final_verification",
        "unnecessary_human_request",
        "unsupported_capability_claim_without_evidence",
        "capability_authorization_scope_confusion",
        "first_attempt_failure_misclassified_as_manual_limit"
      ],
      "metrics": [
        "observable_outcome",
        "correct_sources",
        "correct_routing",
        "completion",
        "human_correction_requests",
        "duration_seconds",
        "token_usage_when_available",
        "safety_preserved"
      ]
    }
  },
