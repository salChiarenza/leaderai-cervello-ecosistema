  "agents": {
    "codex": {
      "templates": [
        {
          "template": "CODEX_README.md",
          "destination": ".codex/README.md",
          "strategy": "create"
        },
        {
          "template": "ISPETTORE_SKILL.md",
          "destination": ".agents/skills/ispettore-ecosistema/SKILL.md",
          "strategy": "create"
        },
        {
          "template": "CODEX_HOOKS.json",
          "destination": ".codex/hooks.json",
          "strategy": "merge_hooks_json"
        }
      ],
      "required": [
        ".codex/README.md",
        ".agents/skills/ispettore-ecosistema/SKILL.md",
        ".codex/hooks.json"
      ],
      "forbidden": [
        ".claude/README.md",
        ".claude/skills/ispettore-ecosistema/SKILL.md"
      ],
      "external_effects": [
        "codex_user_instructions"
      ]
    },
    "claude": {
      "templates": [
        {
          "template": "CLAUDE_README.md",
          "destination": ".claude/README.md",
          "strategy": "create"
        },
        {
          "template": "ISPETTORE_SKILL.md",
          "destination": ".claude/skills/ispettore-ecosistema/SKILL.md",
          "strategy": "create"
        },
        {
          "template": "CLAUDE_SETTINGS.json",
          "destination": ".claude/settings.json",
          "strategy": "merge_hooks_json"
        }
      ],
      "required": [
        ".claude/README.md",
        ".claude/skills/ispettore-ecosistema/SKILL.md",
        ".claude/settings.json"
      ],
      "forbidden": [
        ".codex/README.md",
        ".agents/skills/ispettore-ecosistema/SKILL.md"
      ],
      "external_effects": [
        "claude_user_settings",
        "claude_user_instructions"
      ]
    },
    "both": {
      "includes": [
        "codex",
        "claude"
      ],
      "templates": [],
      "required": [],
      "forbidden": [],
      "external_effects": [
        "claude_user_settings",
        "claude_user_instructions",
        "codex_user_instructions"
      ]
