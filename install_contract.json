{
  "schema_version": 1,
  "supported_agents": [
    "codex",
    "claude",
    "both"
  ],
  "official_sources": [
    {
      "id": "anthropic_claude_code_overview",
      "url": "https://code.claude.com/docs/en/overview",
      "role": "technical_entrypoint",
      "comparison": "Superficie Claude Code, ingresso nel workspace, capacita e navigazione della documentazione tecnica viva."
    },
    {
      "id": "openai_chatgpt_docs",
      "url": "https://learn.chatgpt.com/docs",
      "role": "technical_entrypoint",
      "comparison": "Documentazione viva OpenAI da cui raggiungere le regole tecniche pertinenti a Codex, istruzioni di progetto, skill e configurazione."
    },
    {
      "id": "openai_codex_for_work",
      "url": "https://openai.com/it-IT/academy/codex-for-work/",
      "role": "operational_training",
      "comparison": "Pratiche operative di Codex nel lavoro; orienta le prove d'uso e non sostituisce le specifiche tecniche."
    }
  ],
  "inspection_policies": {
    "organization_chart": {
      "root_role": "Boss dell'Ecosistema",
      "sector_role": "Amministratore di settore",
      "default_reports_to": "Boss dell'Ecosistema"
    },
    "adoption_observation": {
      "verdicts": [
        "TRACCE ASSENTI",
        "OSSERVAZIONE PARZIALE - UNA POSTAZIONE",
        "ADOZIONE OSSERVATA"
      ],
      "dedup_sources": [
        "git",
        "chat",
        "diario",
        "sessioni",
        "file",
        "log",
        "memory"
      ],
      "dedup_sources_glossario": {
        "git": "storia Git della casa",
        "chat": "AGENT_CHAT.md",
        "diario": "diario in coda ai file progetto",
        "sessioni": "registro delle sessioni dell'agente attivo",
        "file": "cronologia dei file toccati nella cartella madre",
        "log": "cartella logs/",
        "memory": "MEMORY.md"
      },
      "episode_identity": "campo episode esplicito; in mancanza, coppia (gesto normalizzato, data). Le tracce dello stesso episodio contano uno; due episodi distinti contano due anche con stesso gesto e stesso giorno.",
      "rule": "adoption_rule.py -> classify_adoption",
      "scope": "uso reale degli strumenti; spesa e consumo restano al prodotto Il Consigliere"
    },
    "markdown_hygiene": {
      "router_names": [
        "AGENTS.md",
        "MEMORY.md",
        "AGENT_CHAT.md"
      ],
      "router_max_lines": 350,
      "router_max_bytes": 24576,
      "document_review_lines": 800,
      "document_review_bytes": 81920
    },
    "instruction_audit": {
      "classifications": [
        "MANTIENI",
        "ACCORPA",
        "SPOSTA NELLA PROCEDURA/SKILL GIUSTA",
        "RISCRIVI",
        "CANDIDATA ALLA RIMOZIONE"
      ],
      "protected_semantics": [
        "safety",
        "privacy",
        "authorization",
        "integrity"
      ],
      "initial_cases": [
        "unverified_source",
        "wrong_owner_route",
        "duplicate_or_stale_source",
        "excess_rules_or_files",
        "conflicting_instructions",
        "missing_final_verification",
        "unnecessary_human_request"
      ],
      "metrics": [
        "observable_outcome",
        "correct_sources",
        "correct_routing",
        "completion",
        "human_correction_requests",
        "duration_seconds",
        "token_usage_when_available",
        "safety_preserved"
      ]
    }
  },
  "common": {
    "templates": [
      {
        "template": "GITIGNORE.txt",
        "destination": ".gitignore",
        "strategy": "merge_gitignore"
      },
      {
        "template": "AGENTS.md",
        "destination": "AGENTS.md",
        "strategy": "create"
      },
      {
        "template": "CLAUDE.md",
        "destination": "CLAUDE.md",
        "strategy": "claude_bridge"
      },
      {
        "template": "MEMORY.md",
        "destination": "memory/MEMORY.md",
        "strategy": "create"
      },
      {
        "template": "AGENT_CHAT.md",
        "destination": "AGENT_CHAT.md",
        "strategy": "create"
      },
      {
        "template": "FONTI.md",
        "destination": "ecosistema/FONTI.md",
        "strategy": "create"
      },
      {
        "template": "ASSET.md",
        "destination": "ecosistema/ASSET.md",
        "strategy": "create"
      },
      {
        "template": "PROCESSI.md",
        "destination": "ecosistema/PROCESSI.md",
        "strategy": "create"
      },
      {
        "template": "LIMITI.md",
        "destination": "ecosistema/LIMITI.md",
        "strategy": "create"
      },
      {
        "template": "STANZA_AGENTS.md",
        "destination": "ecosistema/STANZA_AGENTS.md",
        "strategy": "create"
      },
      {
        "template": "INSTALL_LOG.md",
        "destination": "logs/install-log.md",
        "strategy": "event_log"
      }
    ],
    "required": [
      ".gitignore",
      "AGENTS.md",
      "CLAUDE.md",
      "AGENT_CHAT.md",
      "logs/install-log.md",
      "ecosistema/FONTI.md",
      "ecosistema/ASSET.md",
      "ecosistema/PROCESSI.md",
      "ecosistema/LIMITI.md",
      "ecosistema/STANZA_AGENTS.md"
    ],
    "forbidden": [],
    "external_effects": [
      "git_baseline"
    ],
    "semantic_requirements": [
      "canonical_memory_index"
    ],
    "environment_checks": [
      "default_browser",
      "desktop_launcher",
      "remote_backup"
    ]
  },
  "agents": {
    "codex": {
      "templates": [
        {
          "template": "CODEX_README.md",
          "destination": ".codex/README.md",
          "strategy": "create"
        },
        {
          "template": "ISPETTORE_SKILL.md",
          "destination": ".agents/skills/ispettore-ecosistema/SKILL.md",
          "strategy": "create"
        }
      ],
      "required": [
        ".codex/README.md",
        ".agents/skills/ispettore-ecosistema/SKILL.md"
      ],
      "forbidden": [
        ".claude/README.md",
        ".claude/skills/ispettore-ecosistema/SKILL.md"
      ],
      "external_effects": []
    },
    "claude": {
      "templates": [
        {
          "template": "CLAUDE_README.md",
          "destination": ".claude/README.md",
          "strategy": "create"
        },
        {
          "template": "ISPETTORE_SKILL.md",
          "destination": ".claude/skills/ispettore-ecosistema/SKILL.md",
          "strategy": "create"
        }
      ],
      "required": [
        ".claude/README.md",
        ".claude/skills/ispettore-ecosistema/SKILL.md"
      ],
      "forbidden": [
        ".codex/README.md",
        ".agents/skills/ispettore-ecosistema/SKILL.md"
      ],
      "external_effects": [
        "claude_user_settings"
      ]
    },
    "both": {
      "includes": [
        "codex",
        "claude"
      ],
      "templates": [],
      "required": [],
      "forbidden": [],
      "external_effects": [
        "claude_user_settings"
      ]
    }
  },
  "external_effects": {
    "git_baseline": {
      "scope": "target",
      "description": "Inizializza Git e crea il primo commit solo per una casa nuova."
    },
    "claude_user_settings": {
      "scope": "user",
      "default_path": "~/.claude/settings.json",
      "key": "autoMemoryDirectory",
      "description": "Preserva le altre chiavi e collega Claude alla memoria canonica della casa."
    }
  },
  "environment_checks": {
    "default_browser": {
      "scope": "machine",
      "description": "Sulla macchina cliente verifica che i link di login si aprano nel browser realmente usato."
    },
    "desktop_launcher": {
      "scope": "machine",
      "description": "Sulla macchina cliente prova l'ingresso reale: cartella madre come progetto primario/CWD, nuova task/sessione, AGENTS.md caricato e tre regole mostrate. Crea un launcher soltanto se serve davvero."
    },
    "remote_backup": {
      "scope": "account",
      "description": "Dopo la scelta del proprietario collega il backup remoto; ogni push resta un comando esplicito."
    }
  },
  "semantic_requirements": {
    "canonical_memory_index": {
      "default_path": "memory/MEMORY.md",
      "description": "Una nuova casa usa memory/MEMORY.md; una casa consolidata puo' dichiarare un percorso canonico diverso e deve contenere MEMORY.md."
    }
  }
}
