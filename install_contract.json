  "external_effects": {
    "git_baseline": {
      "scope": "target",
      "description": "Inizializza Git e crea il primo commit solo per una casa nuova."
    },
    "claude_user_settings": {
      "scope": "user",
      "default_path": "~/.claude/settings.json",
      "key": "autoMemoryDirectory",
      "description": "Preserva le altre chiavi e collega Claude alla memoria canonica della casa."
    },
    "claude_user_instructions": {
      "scope": "user",
      "default_path": "~/.claude/CLAUDE.md",
      "template": "CLAUDE_USER.md",
      "strategy": "merge_marked_block",
      "block_start": "<!-- LEADERAI-CASA:inizio -->",
      "block_end": "<!-- LEADERAI-CASA:fine -->",
      "description": "Istruzioni utente di Claude Code lette in ogni sessione: dichiarano la cartella madre e il gate FUORI DAL CERVELLO. Il blocco marcato si aggiunge o si aggiorna; il resto del file resta intatto."
    },
    "codex_user_instructions": {
      "scope": "user",
      "default_path": "~/.codex/AGENTS.md",
      "template": "CODEX_USER_AGENTS.md",
      "strategy": "merge_marked_block",
      "block_start": "<!-- LEADERAI-CASA:inizio -->",
      "block_end": "<!-- LEADERAI-CASA:fine -->",
      "description": "AGENTS.md globale di Codex letto in ogni sessione: dichiara la cartella madre e il gate FUORI DAL CERVELLO. Il blocco marcato si aggiunge o si aggiorna; il resto del file resta intatto."
    }
  },
  "environment_checks": {
    "default_browser": {
      "scope": "machine",
      "description": "Sulla macchina cliente verifica che i link di login si aprano nel browser realmente usato."
    },
    "desktop_launcher": {
      "scope": "machine",
      "description": "Sulla macchina cliente prova l'ingresso reale: cartella madre come progetto primario/CWD, nuova task/sessione, AGENTS.md caricato e tre regole mostrate. Crea un launcher soltanto se serve davvero."
    },
    "remote_backup": {
      "scope": "account",
      "description": "Dopo la scelta del proprietario collega il backup remoto; ogni push resta un comando esplicito."
    },
    "user_instructions_gate": {
      "scope": "machine",
      "description": "Sulla macchina cliente apri l'agente da una cartella estranea alla casa: le istruzioni globali devono farlo rispondere FUORI DAL CERVELLO senza scrivere nulla. Prova su ogni postazione."
    }
  },
  "semantic_requirements": {
    "canonical_memory_index": {
      "default_path": "memory/MEMORY.md",
      "description": "Una nuova casa usa memory/MEMORY.md; una casa consolidata puo' dichiarare un percorso canonico diverso e deve contenere MEMORY.md."
    }
  }
}
